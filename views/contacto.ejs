<%- include('partials/header') %>
<%
  const cfg = typeof config !== 'undefined' ? config : {};
  const wa = String(cfg.whatsapp || (typeof whatsappNumber !== 'undefined' ? whatsappNumber : ''));
  const direccion = cfg.direccion || 'Aguachica, Cesar, Colombia';
  const horario = cfg.horario || 'Lunes a Sábado: 8:00 AM - 6:30 PM';
  const redes = [['Instagram', cfg.instagram], ['Facebook', cfg.facebook], ['TikTok', cfg.tiktok]].filter(r => r[1]);
%>

<main class="bg-slate-300 min-h-screen py-10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center mb-10">
      <span class="text-dorado text-xs font-bold uppercase tracking-widest">Atención al cliente</span>
      <h1 class="text-3xl font-serif font-bold text-esmeralda mt-1">Visítanos o Contáctanos</h1>
      <p class="text-xs text-gray-500 mt-2">Estamos listos para asesorarte en la elección o confección de tu joya ideal.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-2xl border border-gray-200 text-center shadow-sm">
        <span class="flex items-center justify-center w-12 h-12 mx-auto mb-3 rounded-full bg-esmeralda text-dorado"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
        <h3 class="font-serif font-bold text-sm text-esmeralda mb-1">Ubicación Física</h3>
        <p class="text-xs text-gray-600"><%= direccion %></p>
        <a href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(direccion) %>" target="_blank" rel="noopener" class="inline-block mt-3 text-xs font-bold text-esmeralda hover:underline">
          Ver en Google Maps
        </a>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-200 text-center shadow-sm">
        <span class="flex items-center justify-center w-12 h-12 mx-auto mb-3 rounded-full bg-esmeralda text-dorado"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/></svg></span>
        <h3 class="font-serif font-bold text-sm text-esmeralda mb-1">WhatsApp Directo</h3>
        <p class="text-xs text-gray-600">Escríbenos y te asesoramos</p>
        <% if (cfg.telefono) { %>
          <p class="text-[11px] text-gray-400 mt-1">Teléfono: <%= cfg.telefono %></p>
        <% } %>
        <a href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent('Hola, quiero recibir información de Real Joyería Aguachica.') %>" target="_blank" rel="noopener" class="inline-block mt-3 text-xs font-bold text-emerald-600 hover:underline">
          Abrir chat de WhatsApp
        </a>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-gray-200 text-center shadow-sm">
        <span class="flex items-center justify-center w-12 h-12 mx-auto mb-3 rounded-full bg-esmeralda text-dorado"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        <h3 class="font-serif font-bold text-sm text-esmeralda mb-1">Horarios de Atención</h3>
        <p class="text-xs text-gray-600"><%= horario %></p>
      </div>
    </div>

    <!-- FORMULARIO DE CONTACTO -->
    <div class="mt-10 bg-white p-6 sm:p-8 rounded-3xl border border-gray-200 shadow-sm max-w-2xl mx-auto">
      <h2 class="font-serif font-bold text-lg text-esmeralda mb-1">Déjanos tu mensaje</h2>
      <p class="text-xs text-gray-500 mb-5">Te contactaremos por el número que nos dejes.</p>

      <% if (enviado) { %>
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs rounded-xl p-4">
          ¡Gracias! Recibimos tu mensaje y te contactaremos por el número que dejaste.
        </div>
      <% } else { %>
        <% if (error) { %>
          <div class="bg-red-50 border border-red-200 text-red-700 text-xs rounded-xl p-3 mb-4"><%= error %></div>
        <% } %>

        <form action="/contacto" method="POST" class="space-y-4 text-xs">
          <div>
            <label class="block font-bold text-esmeralda mb-1">Nombre</label>
            <input type="text" name="nombre" required maxlength="100" value="<%= valores.nombre %>" class="w-full p-2.5 border rounded-xl focus:outline-none focus:border-dorado">
          </div>
          <div>
            <label class="block font-bold text-esmeralda mb-1">Teléfono o WhatsApp</label>
            <input type="tel" name="telefono" required maxlength="30" value="<%= valores.telefono %>" placeholder="Ej: 300 123 4567" class="w-full p-2.5 border rounded-xl focus:outline-none focus:border-dorado">
          </div>
          <div>
            <label class="block font-bold text-esmeralda mb-1">Mensaje</label>
            <textarea name="mensaje" required rows="4" maxlength="1000" class="w-full p-2.5 border rounded-xl focus:outline-none focus:border-dorado"><%= valores.mensaje %></textarea>
          </div>

          <!-- Campo trampa para bots: las personas no lo ven -->
          <div class="hidden" aria-hidden="true">
            <label>No llenes este campo <input type="text" name="sitio_web" tabindex="-1" autocomplete="off"></label>
          </div>

          <label class="flex items-start gap-2 text-gray-600">
            <input type="checkbox" name="acepta_datos" required class="mt-0.5 rounded">
            <span>Autorizo a Real Joyería Aguachica a tratar mis datos personales (nombre, teléfono y mensaje) únicamente para responder esta consulta.</span>
          </label>

          <button type="submit" class="w-full bg-esmeralda hover:bg-esmeralda-light text-dorado font-bold text-xs uppercase tracking-wider py-3 rounded-xl transition-colors">
            Enviar mensaje
          </button>
        </form>
      <% } %>
    </div>

    <% if (redes.length > 0) { %>
      <div class="mt-8 text-center">
        <p class="text-xs text-gray-600 mb-3">Síguenos en redes sociales</p>
        <div class="flex flex-wrap justify-center gap-3">
          <% redes.forEach(([nombre, url]) => { %>
            <a href="<%= url %>" target="_blank" rel="noopener" class="bg-white border border-dorado/50 text-esmeralda text-xs font-semibold px-5 py-2 rounded-full hover:bg-dorado/10 transition-colors"><%= nombre %></a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
