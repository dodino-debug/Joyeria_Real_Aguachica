<%
  const cfg = typeof config !== 'undefined' ? config : {};
  const wa = String(cfg.whatsapp || (typeof whatsappNumber !== 'undefined' ? whatsappNumber : ''));
  const waTexto = (wa.startsWith('57') && wa.length === 12)
    ? `+57 ${wa.slice(2, 5)} ${wa.slice(5, 8)} ${wa.slice(8)}`
    : (wa ? '+' + wa : '');
  const redes = [['Instagram', cfg.instagram], ['Facebook', cfg.facebook], ['TikTok', cfg.tiktok]].filter(r => r[1]);
%>
<footer class="bg-neutral-900 text-gray-400 text-xs border-t border-neutral-800 pt-10 pb-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">

    <div>
      <span class="block text-lg font-serif font-bold text-white tracking-wider uppercase mb-2">REAL JOYERÍA</span>
      <p class="text-xs text-gray-400">
        Joyería fina en Aguachica, Cesar. Expertos en oro de 18K, plata Ley 925, esmeraldas naturales y joyas personalizadas.
      </p>
           <% if (redes.length > 0) { %>
        <div class="mt-4">
          <span class="block text-[10px] uppercase tracking-[0.2em] text-gray-500 mb-2">Síguenos</span>
          <div class="flex items-center gap-3">

            <% if (cfg.instagram) { %>
              <a href="<%= cfg.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Real Joyería" title="Instagram"
                 class="group flex items-center justify-center w-9 h-9 rounded-full border border-neutral-700 text-gray-400 hover:text-dorado hover:border-dorado hover:bg-neutral-800 hover:-translate-y-0.5 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
              </a>
            <% } %>

            <% if (cfg.tiktok) { %>
              <a href="<%= cfg.tiktok %>" target="_blank" rel="noopener noreferrer" aria-label="TikTok de Real Joyería" title="TikTok"
                 class="group flex items-center justify-center w-9 h-9 rounded-full border border-neutral-700 text-gray-400 hover:text-dorado hover:border-dorado hover:bg-neutral-800 hover:-translate-y-0.5 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor" aria-hidden="true">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              </a>
            <% } %>

            <% if (cfg.facebook) { %>
              <a href="<%= cfg.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook de Real Joyería" title="Facebook"
                 class="group flex items-center justify-center w-9 h-9 rounded-full border border-neutral-700 text-gray-400 hover:text-dorado hover:border-dorado hover:bg-neutral-800 hover:-translate-y-0.5 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            <% } %>

          </div>
        </div>
      <% } %>
    </div>

    <div>
      <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Atención al cliente</h4>
      <ul class="space-y-1.5 text-xs">
        <li>📍 <%= cfg.direccion || 'Aguachica, Cesar, Colombia' %></li>
        <li>📲 WhatsApp: <%= waTexto %></li>
        <% if (cfg.telefono) { %><li>📞 Teléfono: <%= cfg.telefono %></li><% } %>
        <li>🕒 <%= cfg.horario || 'Lunes a Sábado: 8:00 AM - 6:30 PM' %></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Garantía y Legales</h4>
      <p class="text-xs text-gray-400 leading-relaxed">
        Consúltanos por WhatsApp sobre garantías y tratamiento de datos personales.
      </p>
    </div>

  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-neutral-800 pt-4 text-center text-[11px] text-gray-500">
    <p>&copy; <%= new Date().getFullYear() %> Real Joyería Aguachica. Todos los derechos reservados.</p>
  </div>
</footer>

<!-- Botón flotante de WhatsApp -->
<a href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent('Hola, estoy visitando la página de Real Joyería Aguachica y quiero recibir información.') %>"
   target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"
   class="fixed bottom-5 right-5 z-50 flex items-center gap-2 bg-[#25D366] hover:bg-[#1EBE5A] text-white font-bold text-xs px-4 py-3 rounded-full shadow-lg transition-colors">
  <span class="text-base">💬</span>
  <span class="hidden sm:inline">WhatsApp</span>
</a>

</body>
</html>
